# Environment variables — copy to `.env` and fill in real values.
# Never commit the real .env file.

# Database (Postgres)
#
# Production on Vercel:
#   1. Project → Storage → Create Database → Postgres (free Hobby tier).
#   2. Vercel auto-sets POSTGRES_PRISMA_URL. Copy that value into a new
#      env var called DATABASE_URL (Project → Settings → Environment
#      Variables → Production).
#   3. Run `npx prisma db push` with DATABASE_URL set locally to push
#      the schema. (Or trigger a redeploy — the build will run
#      `prisma generate` automatically.)
#
# Local dev:
#   - Easiest: `docker run -d --name aisalon-pg -p 5432:5432 \
#       -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=aisalon \
#       postgres:16`
#   - Then use the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisalon"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email brand logo (top-right of every email, ~24px tall). Optional — if not
# set, the default AI Salon mark on Vercel Blob is used. Per-template
# EmailStageTemplate.logoUrl overrides this.
# EMAIL_BRAND_LOGO_URL="https://uojldinyokysycfc.public.blob.vercel-storage.com/brand-assets/1782393632010-jeorqc.png"

# Google OAuth (MassaPro.com Google credentials)
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID_REDACTED"
GOOGLE_CLIENT_SECRET="GOOGLE_OAUTH_SECRET_REDACTED"

# Admin email — this user gets ADMIN role on sign-in
ADMIN_EMAIL="eze@massapro.com"

# Public site URL — used for OG metadata, OAuth redirects, and absolute URLs.
# In production on Vercel this should be https://aisalon.massapro.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (SMTP) — required for the email/password sign-up flow AND the
# email orchestrator (stage-based + flow-based campaign sends).
#
# Without these set, sign-up still creates the user but cannot email
# the password; the password is logged to the server console instead.
# The orchestrator will also fall back to "mock" mode (no real email
# is sent — queue rows are written but marked SKIPPED).
#
# The orchestrator provider auto-resolves in this priority:
#   1. EMAIL_PROVIDER=gmail + GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
#      GOOGLE_REFRESH_TOKEN → Gmail OAuth2 API
#   2. SMTP_HOST + SMTP_USER + SMTP_PASS → SMTP via nodemailer (RECOMMENDED)
#   3. Otherwise → mock (logs to stdout, no email sent)
#
# RECOMMENDED: SMTP (works with Gmail App Passwords, SendGrid, AWS SES,
# Postmark, Mailgun, Brevo, etc.). The orchestrator + transactional
# emails share the same SMTP transport — one config drives both.
#
# Gmail SMTP example (use an App Password, NOT your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="AI Salon <no-reply@aisalon.massapro.com>"
#
# SendGrid SMTP example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxxxxxxxx
#   SMTP_FROM="AI Salon <no-reply@aisalon.massapro.com>"
#
# AWS SES SMTP example:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-SES-SMTP-username
#   SMTP_PASS=your-SES-SMTP-password
#   SMTP_FROM="AI Salon <no-reply@aisalon.massapro.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Email orchestrator provider override (optional).
# Leave unset to auto-resolve: Gmail if GOOGLE_* creds present + EMAIL_PROVIDER=gmail,
# else SMTP if SMTP_* set, else mock.
# Set to "gmail" to force Gmail OAuth2 (requires GOOGLE_* creds below).
# Set to "mock" to force mock mode (no emails sent — for dev/staging).
EMAIL_PROVIDER=""

# Email "From" address for the Gmail OAuth2 provider (different from SMTP_FROM
# because Gmail requires the From to match the authenticated account).
# Only used when EMAIL_PROVIDER=gmail.
EMAIL_FROM=""

# Hard kill switch — set to "false" to disable ALL email sends (orchestrator
# AND transactional). Useful for staging environments. Default: not set (enabled).
# EMAIL_SEND_ENABLED="true"

# Secret used to authenticate Vercel Cron → /api/email-orchestrator/run and
# /api/cron/email. Generate with: openssl rand -hex 32
# Must be set on Vercel for the cron jobs to fire successfully.
CRON_SECRET=""

# Vercel deploy token — used by `vercel deploy --prod --yes --token $VERCEL_TOKEN`
# Create at: https://vercel.com/account/tokens (scope: Full Account, Expires: ~6mo)
VERCEL_TOKEN=""

# LLM service — used by /api/admin/events/extract for the
# "Extract fields with AI" feature on the New Event page.
#
# Pick ONE of the providers below. The client auto-selects based on which
# env vars are set, in this priority order:
#   1. GEMINI_API_KEY   (RECOMMENDED — free at aistudio.google.com, native JSON)
#   2. KIMI_API_KEY     (works on Vercel, generous free tier)
#   3. OPENAI_API_KEY   (works on Vercel — needs OpenAI account)
#   4. ZAI_BASE_URL+ZAI_API_KEY (DEV ONLY — Vercel can't reach this)
#   5. Fall back to z-ai-web-dev-sdk + /etc/.z-ai-config (DEV ONLY)
#
# ─── Option A: Google Gemini (RECOMMENDED — free, fast, native JSON) ──
# Get a key at: https://aistudio.google.com/apikey
# Free tier: generous quota, fast Flash model, responseMimeType=application/json
# for strict JSON output. Works on Vercel.
#
# IMPORTANT: Gemini blocks requests from some regions (Hong Kong, China, etc.)
# The dev server may receive a 400 "User location is not supported" — this is
# NOT an auth failure. Production on Vercel (us-east-1, etc.) works fine.
#
GEMINI_API_KEY=""
GEMINI_BASE_URL=""   # optional — defaults to https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=""      # optional — defaults to "gemini-flash-latest"; other options: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-pro
#
# ─── Option B: Kimi / Moonshot AI (fallback if Gemini is region-blocked) ──
# Get a key at: https://platform.moonshot.ai (international) or
# https://platform.moonshot.cn (China). The API is OpenAI-compatible.
# IMPORTANT: keys issued at platform.moonshot.ai must use api.moonshot.ai,
#            keys issued at platform.moonshot.cn must use api.moonshot.cn.
#
KIMI_API_KEY=""
KIMI_BASE_URL=""   # optional — defaults to https://api.moonshot.cn/v1; set to https://api.moonshot.ai/v1 if your key is from platform.moonshot.ai
KIMI_MODEL=""      # optional — defaults to moonshot-v1-8k; other options: moonshot-v1-32k, moonshot-v1-128k, kimi-k2.6
#
# ─── Option C: OpenAI (works everywhere, public API) ──────────────────
# Get a key at: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=""
OPENAI_BASE_URL=""   # optional — defaults to https://api.openai.com/v1
OPENAI_MODEL=""      # optional — defaults to gpt-4o-mini
#
# You can also point OPENAI_BASE_URL at any other OpenAI-compatible
# provider (Together AI, Groq, OpenRouter, Fireworks, local Ollama…):
#   OPENAI_BASE_URL = https://api.together.xyz/v1
#   OPENAI_MODEL    = meta-llama/Llama-3.1-70B-Instruct-Turbo
#
# ─── Option D: ZAI internal API (DEV ONLY — does NOT work on Vercel) ──
# `internal-api.z.ai` resolves to private IPs (172.25.x.x) that are only
# reachable from inside the z.ai infrastructure. Vercel's public network
# cannot route to them, so every fetch throws "fetch failed".
#
# In local dev (Super Z runtime), you can leave these blank — the SDK
# reads /etc/.z-ai-config automatically. If you want to override, set:
#
ZAI_BASE_URL=""
ZAI_API_KEY=""
ZAI_CHAT_ID=""
ZAI_USER_ID=""
ZAI_TOKEN=""
